<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Logbook de Treino</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800;900&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap">
<style>
/* Layout: uma coluna estreita, preto e branco. O número gigante da semana, com a barra dupla (esta semana x semana passada), é o único gesto ousado; o resto é linha fina e tipografia quieta. Abas fixas embaixo. */
:root {
  --bg: #050505;
  --surface: #0f0f0f;
  --line: #242424;
  --line-strong: #3a3a3a;
  --fg: #f5f5f5;
  --muted: #9b9b9b;
  --dim: #6a6a6a;
  --font-display: 'Big Shoulders Display', 'Oswald', 'Arial Narrow', Impact, sans-serif;
  --font-body: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace;
  color-scheme: dark;
}
*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  background: var(--bg);
  color: var(--fg);
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 1.45;
  padding-block: 20px 0;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
}
.app { max-width: 560px; margin: 0 auto; padding-bottom: 120px; }
button, input, textarea { font: inherit; color: inherit; }
button { cursor: pointer; }
:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }
.mono { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }

/* Topo */
.top { display: grid; gap: 8px; margin-bottom: 22px; }
.brand { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
h1 { margin: 0; font: 800 46px/1 var(--font-display); letter-spacing: .05em; text-transform: uppercase; }
.today { font: 500 12px var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
.hello { margin: 0; font-size: 15px; font-weight: 600; }
.status { margin: 0; display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--muted); }
.dot { width: 7px; height: 7px; border-radius: 50%; background: var(--dim); flex: none; }
.status[data-s="cloud"] .dot, .status[data-s="local"] .dot { background: var(--fg); }

/* Rótulos e títulos */
.eyebrow { font: 600 11px var(--font-body); letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
h2 { margin: 0; font: 700 28px/1.05 var(--font-display); letter-spacing: .04em; text-transform: uppercase; }
.sec-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin: 34px 0 12px; }
.sec-head:first-child { margin-top: 0; }
.muted { color: var(--muted); }
.empty { margin: 0; padding: 18px 0; color: var(--muted); border-top: 1px solid var(--line); }

/* Botões e campos */
.inp {
  width: 100%; height: 50px; padding: 0 12px; font-size: 16px;
  background: var(--bg); border: 1px solid var(--line-strong); border-radius: 4px;
  -webkit-appearance: none; appearance: none;
}
.inp:focus { border-color: var(--fg); outline: none; }
.inp::placeholder { color: var(--dim); }
.field { display: grid; gap: 7px; min-width: 0; }
.panel { border: 1px solid var(--line-strong); background: var(--surface); border-radius: 4px; padding: 18px 16px; display: grid; gap: 16px; }
.srow { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.ctl { display: flex; align-items: stretch; }
.ctl button {
  width: 48px; height: 48px; background: var(--bg); border: 1px solid var(--line-strong);
  font: 500 22px var(--font-mono); line-height: 1;
}
.ctl button:first-child { border-radius: 4px 0 0 4px; }
.ctl button:last-child { border-radius: 0 4px 4px 0; }
.ctl button:active { background: var(--fg); color: var(--bg); }
.ctl input {
  width: 84px; height: 48px; text-align: center; font: 500 19px var(--font-mono);
  background: var(--bg); border: 1px solid var(--line-strong); border-left: 0; border-right: 0; border-radius: 0;
  padding: 0; margin: 0;
}
.ctl input:focus { outline: none; background: var(--surface); }
.ctl input::placeholder { color: var(--dim); }
.go {
  height: 56px; background: var(--fg); color: var(--bg); border: 0; border-radius: 4px;
  font: 800 21px var(--font-display); letter-spacing: .1em; text-transform: uppercase;
}
.go:active { opacity: .85; }
.go:disabled { opacity: .5; cursor: default; }
.ghost {
  height: 48px; padding: 0 14px; background: transparent; border: 1px solid var(--line-strong); border-radius: 4px;
  font: 600 14px var(--font-body);
}
.ghost:active { background: var(--fg); color: var(--bg); }
.ghost:disabled { opacity: .5; cursor: default; }
.ghost.xs { height: 36px; padding: 0 12px; font-size: 12px; letter-spacing: .06em; text-transform: uppercase; }
.ghost[aria-expanded="true"] { background: var(--fg); color: var(--bg); border-color: var(--fg); }
.when { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
.when-text { font: 500 14px var(--font-mono); flex: 1; min-width: 0; }
.chips { display: flex; flex-wrap: wrap; gap: 8px; }
.chip { height: 40px; padding: 0 15px; background: transparent; border: 1px solid var(--line-strong); border-radius: 4px; font-weight: 500; }
.chip.sm { height: 34px; padding: 0 12px; font-size: 13px; }
.chip[aria-pressed="true"] { background: var(--fg); color: var(--bg); border-color: var(--fg); font-weight: 600; }
.seg { display: inline-flex; border: 1px solid var(--line-strong); border-radius: 4px; overflow: hidden; }
.seg button { height: 34px; padding: 0 13px; background: transparent; border: 0; font-size: 13px; font-weight: 500; }
.seg button + button { border-left: 1px solid var(--line-strong); }
.seg button[aria-pressed="true"] { background: var(--fg); color: var(--bg); font-weight: 600; }
.seg.wide { display: grid; grid-template-columns: repeat(3, 1fr); }
.seg.wide button { height: 46px; font-size: 14px; }
.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.grid2 label { display: grid; gap: 6px; min-width: 0; font-size: 13px; color: var(--muted); }

/* Aviso fixo */
.toast {
  position: fixed; z-index: 6; margin: 0 auto; max-width: 528px;
  left: max(16px, env(safe-area-inset-left, 0px)); right: max(16px, env(safe-area-inset-right, 0px));
  bottom: calc(58px + env(safe-area-inset-bottom, 0px) + 12px);
  padding: 12px 14px; background: var(--fg); color: var(--bg); border-radius: 4px; font-weight: 600; font-size: 14px;
}

/* Painel da semana */
.hero { border: 1px solid var(--line-strong); background: var(--surface); border-radius: 4px; padding: 16px 16px 4px; }
.hero-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
.hero-main { display: flex; align-items: flex-end; justify-content: space-between; gap: 8px 14px; flex-wrap: wrap; padding: 6px 0 4px; }
.num { font: 800 clamp(88px, 30vw, 132px)/.84 var(--font-display); font-variant-numeric: tabular-nums; min-width: 0; }
.hero-side { display: grid; gap: 8px; justify-items: end; text-align: right; padding-bottom: 6px; }
.dchip { font: 600 13px var(--font-mono); padding: 6px 10px; border: 1px solid var(--line-strong); border-radius: 4px; white-space: nowrap; }
.dchip.up { background: var(--fg); color: var(--bg); border-color: var(--fg); }
.vs { margin: 4px 0 16px; font-size: 13px; color: var(--muted); }
.vs b { color: var(--fg); font-weight: 600; }
.hint { margin: 0 0 14px; font-size: 13px; color: var(--muted); }
.chart { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; height: 130px; border-bottom: 1px solid var(--line-strong); }
.col { min-width: 0; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 4px; }
.pair { width: 100%; display: flex; align-items: flex-end; justify-content: center; gap: 3px; }
.b { display: block; flex: 1; max-width: 16px; }
.b.cur { background: var(--fg); }
.b.prev { background: transparent; border: 1px solid var(--muted); }
.b.zero { height: 2px; background: var(--dim); border: 0; }
.cval { font: 500 11px var(--font-mono); color: var(--muted); line-height: 1; min-height: 11px; }
.labs { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; margin-top: 7px; }
.labs.edge { display: flex; justify-content: space-between; }
.lab { text-align: center; font: 500 10px var(--font-mono); color: var(--muted); text-transform: uppercase; }
.labs.edge .lab { font-size: 11px; }
.lab.today { color: var(--fg); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
.legend { display: flex; gap: 16px; flex-wrap: wrap; margin: 12px 0 4px; font-size: 12px; color: var(--muted); }
.legend i { display: inline-block; width: 10px; height: 10px; margin-right: 6px; vertical-align: -1px; }
.legend .sw-cur { background: var(--fg); }
.legend .sw-prev { border: 1px solid var(--muted); }
.kv .row2 { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 13px 0; border-top: 1px solid var(--line); }
.hero .kv { margin-top: 10px; }
.lblc { display: grid; gap: 3px; min-width: 0; }
.prevv { font-size: 12px; color: var(--muted); }
.kv .val { font: 500 19px var(--font-mono); font-variant-numeric: tabular-nums; }
.kv .val small { font-size: 12px; color: var(--muted); margin-left: 4px; }
.kv .right { display: flex; align-items: baseline; gap: 12px; }
.delta { font: 500 12px var(--font-mono); white-space: nowrap; color: var(--muted); }
.delta.up, .delta.chg { color: var(--fg); font-weight: 600; }
.delta em { font-style: normal; color: var(--muted); font-weight: 400; }
.note { margin: 12px 0 0; font-size: 12px; color: var(--muted); }

/* Compartilhar */
.share { margin-top: 12px; display: grid; gap: 12px; padding: 16px; border: 1px solid var(--line-strong); border-radius: 4px; background: var(--surface); }
.share textarea {
  width: 100%; min-height: 150px; resize: none; padding: 12px; font: 400 13px/1.55 var(--font-mono);
  background: var(--bg); border: 1px solid var(--line-strong); border-radius: 4px;
}
.check { display: flex; align-items: center; gap: 10px; font-size: 14px; }
.check input { width: 20px; height: 20px; accent-color: var(--fg); margin: 0; }
.share-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.share-actions .go { grid-column: 1 / -1; height: 52px; font-size: 19px; }

/* Listas de treino */
.list { list-style: none; margin: 0; padding: 0; }
.row { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-items: center; gap: 12px; padding: 13px 0; border-top: 1px solid var(--line); }
.row:last-child { border-bottom: 1px solid var(--line); }
.rname { font-weight: 600; overflow-wrap: anywhere; }
.rmeta { font: 500 13px var(--font-mono); color: var(--muted); white-space: nowrap; }
.del {
  min-width: 40px; height: 36px; padding: 0 10px; background: transparent; color: var(--muted);
  border: 1px solid var(--line-strong); border-radius: 4px; font: 500 12px var(--font-body); white-space: nowrap;
}
.del.armed { background: var(--fg); color: var(--bg); border-color: var(--fg); font-weight: 600; }
.day { margin-bottom: 26px; }
.day-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; }
.day-head h3 { margin: 0; font: 700 22px/1.1 var(--font-display); letter-spacing: .05em; text-transform: uppercase; }
.day-head span { font: 500 12px var(--font-mono); color: var(--muted); }

/* Resumo */
.range { margin: 14px 0 6px; font-size: 13px; color: var(--muted); }
.stat { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 6px 14px; padding: 12px 0 14px; border-bottom: 1px solid var(--line); }
.stat .num { font-size: clamp(64px, 22vw, 104px); }
.stat-side { display: grid; gap: 5px; justify-items: end; text-align: right; padding-bottom: 6px; }
.kv.panel-free .row2 { border-top: 0; border-bottom: 1px solid var(--line); }
.bar { width: 100%; background: var(--fg); }
.bar.zero { background: var(--dim); height: 2px; }
.chart.simple { display: flex; gap: 3px; align-items: flex-end; }
.chart.simple .col { flex: 1; height: 100%; }
.labs.simple { display: flex; gap: 3px; }
.labs.simple .lab { flex: 1; min-width: 0; }
.ex { border-top: 1px solid var(--line); }
.ex:last-child { border-bottom: 1px solid var(--line); }
.ex summary { list-style: none; cursor: pointer; padding: 14px 0; display: grid; gap: 9px; grid-template-columns: minmax(0, 1fr) auto; }
.ex summary::-webkit-details-marker { display: none; }
.ex-name { font-weight: 600; overflow-wrap: anywhere; }
.ex-plus { font: 500 18px/1 var(--font-mono); color: var(--muted); }
.ex[open] .ex-plus::before { content: "−"; }
.ex:not([open]) .ex-plus::before { content: "+"; }
.meter { grid-column: 1 / -1; height: 4px; background: var(--line); }
.meter i { display: block; height: 100%; background: var(--fg); }
.ex-meta { font: 500 13px var(--font-mono); color: var(--muted); }
.ex-foot { grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
.sess { list-style: none; margin: 0 0 14px; padding: 0 0 0 12px; border-left: 1px solid var(--line-strong); display: grid; gap: 8px; }
.sess li { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; font: 500 13px var(--font-mono); }
.sess li span:first-child { color: var(--muted); }
.sess .best { margin-top: 2px; color: var(--muted); font: 500 12px var(--font-mono); }

/* Navegação */
.tabs {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 5; background: var(--bg); border-top: 1px solid var(--line-strong);
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
  padding-bottom: env(safe-area-inset-bottom, 0px);
}
.tabs-in { max-width: 560px; margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr); }
.tabs a {
  display: flex; align-items: center; justify-content: center; height: 58px; color: var(--muted); text-decoration: none;
  font: 700 16px var(--font-display); letter-spacing: .08em; text-transform: uppercase; border-top: 3px solid transparent; margin-top: -1px;
}
.tabs a[aria-current="page"] { color: var(--fg); border-top-color: var(--fg); }
@media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
